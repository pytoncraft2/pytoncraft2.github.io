---
import CareerRoute from '../lib/components/CareerRoute.astro';
import CyclistGame from '../lib/components/CyclistGame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '#lib/components/Button.svelte';
import HeroScene from '#lib/components/HeroScene.svelte';
import ProjectCarousel, { type CarouselProject } from '#lib/components/ProjectCarousel.svelte';
import TechIcon from '#lib/components/TechIcon.svelte';
import { homeTechs } from '#lib/data/skills.js';
import { projectPath, withBase } from '#lib/paths.js';
import { getFeaturedProjects } from '#lib/projects.js';

const name = 'Timothée Hennequin';
const email = 'timothennequin@gmail.com';
const linkedInHref = 'https://www.linkedin.com/in/timothee-hennequin/';
const cvHref = withBase('cv-timothee-hennequin.pdf');

const cards: CarouselProject[] = (await getFeaturedProjects()).map(({ id, data }) => ({
	slug: id,
	href: projectPath(id),
	title: data.title,
	tags: data.tags,
	description: data.description,
	imageSrc: withBase(data.image),
	imageAlt: data.imageAlt
}));


---

<BaseLayout
	title={`${name} • Développeur web full-stack, formé à l’UX/UI`}
	description={`Portfolio de ${name}, développeur web full-stack : applications en production, études de cas en développement et en conception d’interfaces.`}
>
	<!-- Le script de retour (BaseLayout) a besoin du carrousel dès le premier rendu. -->
	<link slot="head" rel="expect" href="#projets-carousel" blocking="render" />
	<script is:inline>
		// Section affichée dès la première image (élément actif du dock, ensuite tenu à jour par
		// trackSection) : au retour arrière, celle qu’on avait quittée ; sinon, celle de l’ancre.
		try {
			var navigationEntry = performance.getEntriesByType('navigation')[0];
			var savedSection = sessionStorage.getItem('home-section');
			var hashSection = location.hash.slice(1);
			var sections = ['accueil', 'projets', 'profil', 'contact'];
			document.documentElement.dataset.section =
				navigationEntry && navigationEntry.type === 'back_forward' && sections.indexOf(savedSection) >= 0
					? savedSection
					: sections.indexOf(hashSection) >= 0
						? hashSection
						: 'accueil';
		} catch (e) {}
		window.addEventListener('pagehide', function () {
			try {
				sessionStorage.setItem('home-section', document.documentElement.dataset.section || '');
			} catch (e) {}
		});
		// Animations du paysage jouées une fois par session (voir HeroScene.svelte).
		var referringPage = document.referrer && new URL(document.referrer);
		if (location.hash === '#projets' && referringPage && referringPage.origin === location.origin &&
			/\/projets\/[^/]+\/?$/.test(referringPage.pathname)) {
			document.documentElement.setAttribute('data-scene-played', '');
		}
		try {
			if (sessionStorage.getItem('hero-scene-played')) {
				document.documentElement.setAttribute('data-scene-played', '');
			}
			sessionStorage.setItem('hero-scene-played', '1');
		} catch (e) {}
	</script>
	<div class="page" data-snap-blocks>
		<section class="hero snap-block" data-section="accueil" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow ds-label-m">Portfolio</p>
				<h1 id="hero-title" class="ds-h1">{name}</h1>
				<p class="role ds-body-l">Développeur web full-stack, formé&nbsp;à&nbsp;l’UX/UI</p>
				<p class="intro ds-body-m">
					Je développe des applications web de bout en bout, du besoin à la mise en production.
				</p>
				<div class="actions">
					<Button href="#projets">Voir mes projets</Button>
					<Button href="#contact" variant="secondary">Me contacter</Button>
				</div>
				<CyclistGame />
			</div>

			<aside class="proofs" aria-label="Points clés">
				<dl class="proofs-list">
					<div class="proof-note">
						<dt>Développement web</dt>
						<dd>Titre niveau 7 Epitech, 4 ans d’alternance</dd>
					</div>
					<div class="proof-note">
						<dt>UX/UI Design</dt>
						<dd>Certification niveau 6 en cours</dd>
					</div>
					<div class="proof-note">
						<dt>En production</dt>
						<dd>Vroum · +90 000 visites en 2025</dd>
					</div>
				</dl>
			</aside>

			<HeroScene client:idle />
		</section>

		<div id="projets" class="anchor"></div>
		<section class="section section-flush snap-block" data-section="projets" aria-labelledby="projets-title">
			<h2 id="projets-title" class="ds-h2">Sélection de projets</h2>
			<ProjectCarousel client:load projects={cards} />
		</section>

		<div id="profil" class="anchor"></div>
		<section class="section profil section-flush snap-block" data-section="profil" data-stack-cover aria-labelledby="profil-title">
			<div class="profil-card">
				<h2 id="profil-title" class="ds-h2">Profil</h2>
				<p class="ds-body-m">
					Développeur web depuis 2021, j’ai appris le métier sur une application métier en production chez EasySAV, puis
					sur Vroum, que je développe et maintiens bénévolement. Ma formation en Product Design me donne les méthodes pour
					partir des utilisateurs : entretiens, prototypes, tests et accessibilité.
				</p>
				<h3 id="tech-title" class="subhead">Technologies</h3>
				<ul class="tech-grid" aria-labelledby="tech-title">
					{
						homeTechs.map((item) => (
							<li>
								<span class="tech-item">
									<TechIcon name={item.id} />
									<span>{item.label}</span>
								</span>
							</li>
						))
					}
				</ul>
				<div class="profil-cv">
					<Button href={cvHref} variant="secondary">Voir mon CV (PDF)</Button>
				</div>
			</div>
			<CareerRoute />
		</section>

		<div id="contact" class="anchor"></div>
		<section class="contact snap-block" data-section="contact" data-stack-empty aria-labelledby="contact-title">
			<div class="bubble">
				<h2 id="contact-title" class="ds-h2">Contactez-moi&nbsp;!</h2>
				<p class="contact-intro ds-body-m">
					Je recherche un CDI de développeur web full-stack, partout en France. Pour en parler, ou pour un projet, écrivez-moi.
				</p>
				<div class="contact-actions">
					<Button href={`mailto:${email}`}>M’écrire</Button>
					<Button href={linkedInHref} variant="secondary">LinkedIn</Button>
					<Button href={cvHref} variant="secondary">Voir mon CV (PDF)</Button>
				</div>
				<p class="contact-email ds-body-s">
					Ou directement : <a href={`mailto:${email}`}>{email}</a>
				</p>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	import { contactBubble } from '#lib/contact-bubble.js';
	import { snapBlocks, stackBlocks, trackSection } from '#lib/snap-blocks.js';

	// Défilement et empilement par blocs de l’accueil (attachments Svelte réutilisés tels quels).
	const page = document.querySelector<HTMLElement>('[data-snap-blocks]');
	if (page) {
		snapBlocks(page);
		stackBlocks(page);
		trackSection(page);
	}

	// Bulle de contact au-dessus du cycliste, et zoom du décor vers lui, en bas de l'accueil.
	const contact = document.querySelector<HTMLElement>('.contact');
	if (contact) {
		contactBubble(contact);
	}

	// Seulement une étape au clavier si la liste déborde et peut être défilée.
	const proofs = document.querySelector<HTMLElement>('.proofs-list');
	if (proofs) {
		const updateProofsTabStop = () => {
			const scrollable = getComputedStyle(proofs).overflowX === 'auto' &&
				proofs.scrollWidth > proofs.clientWidth + 1;
			if (scrollable) proofs.tabIndex = 0;
			else proofs.removeAttribute('tabindex');
		};
		const observer = new ResizeObserver(updateProofsTabStop);
		observer.observe(proofs);
		window.addEventListener('resize', updateProofsTabStop, { passive: true });
		for (const note of proofs.children) observer.observe(note);
		updateProofsTabStop();
	}

	const carousel = document.getElementById('projets-carousel');
	if (carousel) {
		let gesture: { pointerId: number; x: number; y: number; scrollLeft: number } | undefined;
		let dragged = false;
		let settleFrame = 0;
		const stopSettling = () => {
			cancelAnimationFrame(settleFrame);
			carousel.removeAttribute('data-settling');
		};
		carousel.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
			if (!(event.target instanceof HTMLAnchorElement)) return;

			const card = event.target.closest('li');
			if (!card || card.parentElement !== carousel) return;
			event.preventDefault();

			const sibling = event.key === 'ArrowRight' ? card.nextElementSibling : card.previousElementSibling;
			const link = sibling?.querySelector<HTMLAnchorElement>('a[href]');
			if (!sibling || !link) return;

			stopSettling();
			const viewport = carousel.getBoundingClientRect();
			const bounds = sibling.getBoundingClientRect();
			const offset = bounds.left < viewport.left
				? bounds.left - viewport.left
				: Math.max(0, bounds.right - viewport.right);
			if (Math.abs(offset) > 1) {
				carousel.scrollTo({ left: carousel.scrollLeft + offset, behavior: 'instant' });
			}
			link.focus({ preventScroll: true });
		});

		carousel.addEventListener('wheel', stopSettling, { passive: true });
		window.addEventListener('keydown', stopSettling);
		document.addEventListener('pointerdown', (event) => {
			if (!(event.target instanceof Node) || !carousel.contains(event.target) || event.pointerType !== 'mouse') {
				stopSettling();
			}
		}, { capture: true });

		carousel.addEventListener('pointerdown', (event) => {
			dragged = false;
			if (event.pointerType !== 'mouse' || event.button !== 0 || carousel.scrollWidth <= carousel.clientWidth) return;
			cancelAnimationFrame(settleFrame);
			gesture = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, scrollLeft: carousel.scrollLeft };
		});

		window.addEventListener('pointermove', (event) => {
			if (gesture?.pointerId !== event.pointerId) return;
			if (!(event.buttons & 1)) {
				endDrag(event);
				return;
			}
			const delta = event.clientX - gesture.x;
			if (!dragged) {
				const vertical = Math.abs(event.clientY - gesture.y);
				if (vertical > 6 && vertical > Math.abs(delta)) {
					gesture = undefined;
					stopSettling();
					return;
				}
				if (Math.abs(delta) < 6) return;
				dragged = true;
				carousel.setAttribute('data-dragging', '');
				carousel.setPointerCapture(event.pointerId);
				window.getSelection()?.removeAllRanges();
			}
			carousel.scrollTo({ left: gesture.scrollLeft - delta, behavior: 'instant' });
		});

		const endDrag = (event: PointerEvent) => {
			if (gesture?.pointerId !== event.pointerId) return;
			gesture = undefined;
			if (!dragged && !carousel.hasAttribute('data-settling')) return;
			// Garder le snap désactivé jusqu’à l’arrivée sur la carte choisie.
			carousel.setAttribute('data-settling', '');
			carousel.removeAttribute('data-dragging');
			const start = carousel.scrollLeft;
			const limit = carousel.scrollWidth - carousel.clientWidth;
			const stops = Array.from(carousel.children, card => Math.min((card as HTMLElement).offsetLeft, limit));
			const target = stops.reduce((best, left) => Math.abs(left - start) < Math.abs(best - start) ? left : best, 0);
			const distance = target - start;
			if (Math.abs(distance) < 1 || document.documentElement.hasAttribute('data-reduced-motion') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
				carousel.scrollTo({ left: target, behavior: 'instant' });
				stopSettling();
				return;
			}
			const started = performance.now();
			const duration = Math.min(320, 160 + Math.abs(distance) / 2);
			function advance(now: number) {
				const progress = document.documentElement.hasAttribute('data-reduced-motion')
					? 1
					: Math.min(1, (now - started) / duration);
				carousel?.scrollTo({ left: start + distance * (1 - (1 - progress) ** 3), behavior: 'instant' });
				if (progress < 1) settleFrame = requestAnimationFrame(advance);
				else stopSettling();
			}
			settleFrame = requestAnimationFrame(advance);
		};

		window.addEventListener('pointerup', endDrag);
		window.addEventListener('pointercancel', endDrag);
		carousel.addEventListener('lostpointercapture', endDrag);
		carousel.addEventListener('dragstart', (event) => {
			if (gesture) event.preventDefault();
		});
		carousel.addEventListener('click', (event) => {
			if (!dragged || event.detail === 0) return;
			event.preventDefault();
			event.stopImmediatePropagation();
		}, { capture: true });
	}

</script>

<style>
	@media (pointer: fine) {
		:global(#projets-carousel) {
			cursor: grab;
		}
	}

	:global(#projets-carousel > li) {
		display: flex;
	}

	:global(#projets-carousel .link) {
		align-self: flex-start;
		min-height: 44px;
		padding-inline: var(--spacing-4);
		border: 1px solid color-mix(in srgb, var(--action-primary) 65%, transparent);
		border-radius: var(--radius-md);
		cursor: pointer;
	}

	:global(#projets-carousel .link:hover),
	:global(#projets-carousel .link:focus-visible) {
		border-color: var(--action-primary);
		background: color-mix(in srgb, var(--action-primary) 10%, transparent);
		text-decoration: none;
	}


	:global(#projets-carousel:is([data-dragging], [data-settling])) {
		scroll-snap-type: none;
	}

	:global(#projets-carousel[data-dragging]) {
		user-select: none;
	}

	:global(#projets-carousel[data-dragging]),
	:global(#projets-carousel[data-dragging] *) {
		cursor: grabbing;
	}

	.page {
		display: contents;
	}

	/* Empilement : chaque section glisse par-dessus la précédente (voir stackBlocks). */
	:global(html:not([data-reduced-motion])) .page[data-stacked] > .snap-block {
		position: sticky;
		top: var(--stack-top);
	}

	/*
	 * Cibles des ancres, hors des sections : une section collée en haut de l’écran
	 * ne ferait pas défiler la page vers elle quand on y remonte par un lien.
	 */
	.anchor {
		height: 0;
	}

	/*
	 * Le contenu de la section recouverte s’efface (`--stack-opacity`, posé par stackBlocks).
	 * Dans le hero, seuls le texte et les encarts s’effacent : le paysage reste visible.
	 */
	:global(html:not([data-reduced-motion])) .page[data-stacked] > .section,
	:global(html:not([data-reduced-motion])) .page[data-stacked] > .hero > :is(.hero-copy, .proofs) {
		opacity: var(--stack-opacity, 1);
	}

	:global(html:not([data-reduced-motion])) .page[data-stacked] > .section[data-covered],
	:global(html:not([data-reduced-motion])) .page[data-stacked] > .hero[data-covered] > :is(.hero-copy, .proofs) {
		pointer-events: none;
	}

	.hero {
		/* Hauteur de la bande de paysage de HeroScene, sous le texte. */
		--hero-scene-band: clamp(9rem, 22.2vw, 26rem);
		position: relative;
		isolation: isolate;
		display: grid;
		gap: var(--spacing-8);
		padding-bottom: calc(var(--hero-scene-band) * 0.7);
		margin-bottom: clamp(var(--spacing-10), 6vw, var(--spacing-16));
	}


	:global(html[data-section='projets']) .hero :global(.rider) {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero :global(.rider) {
			transition: opacity 220ms ease;
		}
	}

	/* Keep the home layout in flow so the landscape stays anchored to the same ground line. */
	.hero[data-playing] .hero-copy > :not(:global([data-cyclist-game])),
	.hero[data-playing] .proofs {
		visibility: hidden;
	}

	.hero-copy > :global([data-cyclist-game]) {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
	}

	.hero-copy {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
		min-width: 0;
	}

	.eyebrow {
		margin: 0;
		color: var(--text-secondary);
	}

	.hero h1,
	.role,
	.intro {
		margin: 0;
	}

	.role {
		color: var(--text-primary);
	}

	.intro {
		max-width: 40rem;
		color: var(--text-secondary);
	}

	.proofs {
		min-width: 0;
	}

	@media (max-width: 39.99rem) {
		.proofs {
			display: none;
		}
	}

	.proofs-list {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: stretch;
		gap: var(--spacing-3);
		margin: 0;
		padding-block: var(--spacing-1);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		scroll-snap-type: x proximity;
		-webkit-overflow-scrolling: touch;
	}

	.proofs-list:focus-visible {
		outline: 2px solid var(--action-focus);
		outline-offset: 2px;
	}

	.proof-note {
		position: relative;
		flex: 0 0 auto;
		width: max-content;
		max-width: none;
		padding: var(--spacing-3) var(--spacing-5) var(--spacing-3) var(--spacing-8);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-md);
		background: var(--surface-elevated);
		scroll-snap-align: start;
		corner-bottom-left-shape: bevel;
	}

	.proof-note::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		width: 0.7rem;
		height: 0.7rem;
		border: 1px solid var(--scrollbar-thumb);
		border-radius: var(--radius-full);
		background: var(--surface-subtle);
		box-shadow: 0 0 0 2px var(--surface-elevated);
		pointer-events: none;
	}

	.proofs-list dt {
		margin: 0 0 var(--spacing-1);
		color: var(--text-primary);
		font: 600 var(--text-body-m-size) / var(--text-body-m-line) var(--font-sans);
	}

	.proofs-list dd {
		margin: 0;
		color: var(--text-secondary);
		font: 400 var(--text-body-s-size) / var(--text-body-s-line) var(--font-sans);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-4);
		margin-top: var(--spacing-2);
	}

	.section {
		margin-bottom: var(--spacing-8);
		padding: var(--spacing-8);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-lg);
		background: var(--surface-elevated);
	}

	.section-flush {
		padding: 0;
		border: none;
		background: transparent;
	}

	.section h2 {
		margin: 0 0 var(--spacing-4);
	}

	.section h3 {
		margin: var(--spacing-8) 0 var(--spacing-4);
	}

	.section p {
		margin: 0 0 var(--spacing-4);
		max-width: 40rem;
	}

	.profil-card {
		padding: var(--spacing-8);
		background: var(--surface-elevated);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-lg);
	}

	.profil .subhead {
		margin: var(--spacing-6) 0 var(--spacing-3);
		color: var(--text-primary);
		font: 600 var(--text-body-m-size) / var(--text-body-m-line) var(--font-sans);
	}

	.profil .subhead:first-of-type {
		margin-top: var(--spacing-2);
	}

	.profil-cv {
		margin-top: var(--spacing-8);
	}

	.tech-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-3) var(--spacing-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tech-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-1);
		min-width: 0;
		--tech-icon-size: 1.5rem;
		color: var(--text-secondary);
		text-align: center;
		font: 500 0.75rem / 1rem var(--font-sans);
	}

	.tech-item span {
		color: var(--text-primary);
	}

	/*
	 * Fin de page : Contact, transparente, occupe la hauteur de l'écran jusqu'au pied de page
	 * (marge de défilement en haut, marge de la section, bas de <main>, pied de page), au-dessus
	 * du paysage. Son contenu est une bulle de BD qui sort de la tête du cycliste (position
	 * `--bubble-x` / `--bubble-y`, calculée par contact-bubble.ts) quand la section est affichée.
	 * Sur ordinateur, le pied de page se superpose au bas de Contact au lieu de s'empiler
	 * dessous : la fin de page garde la hauteur de l'écran, et le hero collé n'est pas repoussé
	 * vers le haut dans les dernières images de la glissade (écrans peu hauts).
	 */
	.contact {
		--footer-height: calc(var(--spacing-6) + var(--text-body-s-line) + 5.5rem);
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: calc(100svh - 1.5rem - 2 * var(--spacing-8) - var(--footer-height));
		margin-bottom: var(--spacing-8);
	}

	/* Contour et ombre de la bulle : adoucis en thème sombre, où le texte principal est presque blanc. */
	.bubble {
		--bubble-ink: var(--text-primary);
		--bubble-border: 2px solid var(--bubble-ink);
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
		padding: var(--spacing-6);
		border: var(--bubble-border);
		border-radius: var(--radius-xl);
		background: var(--surface-elevated);
		box-shadow: 4px 4px 0 var(--bubble-ink);
	}

	:global(html[data-theme='dark']) .bubble {
		--bubble-ink: var(--text-secondary);
	}

	.contact h2,
	.contact-intro,
	.contact-email {
		margin: 0;
	}

	.contact-intro {
		max-width: 32rem;
		color: var(--text-secondary);
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}

	.contact-email {
		color: var(--text-secondary);
	}

	.contact-email a {
		color: var(--action-primary);
		font-weight: 500;
	}

	.contact-email a:focus-visible {
		outline: 2px solid var(--action-focus);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	/* Ordinateur : la bulle flotte au-dessus du cycliste, sa pointe vers sa tête. */
