---
import { render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { getFeaturedProjects, getNextProject, type ProjectEntry } from '#lib/projects.js';

export async function getStaticPaths() {
	const projects = await getFeaturedProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project, next: getNextProject(projects, project.id) }
	}));
}

type Props = {
	project: ProjectEntry;
	next?: ProjectEntry;
};

const { project, next } = Astro.props;
const { Content } = await render(project);
---

<CaseStudyLayout project={project} next={next}>
	<Content />
</CaseStudyLayout>
