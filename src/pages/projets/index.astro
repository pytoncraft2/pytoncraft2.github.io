---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '#lib/components/ProjectCard.svelte';
import WindowFrame from '#lib/components/WindowFrame.svelte';
import { projectCategories, projectCategoryLabels } from '#lib/data/project-categories.js';
import { projectPath, withBase } from '#lib/paths.js';
import { getProjects } from '#lib/projects.js';

// Toutes les études de cas, y compris celles retirées du carrousel, regroupées par famille.
const projects = await getProjects();
const groups = projectCategories
	.map((category) => ({
		category,
		label: projectCategoryLabels[category],
		projects: projects.filter((project) => project.data.category === category)
	}))
	.filter((group) => group.projects.length > 0);
---

<BaseLayout
	title="Tous les projets • Timothée Hennequin"
	description="Toutes les études de cas de Timothée Hennequin : développement web, conception UX/UI, IoT et systèmes embarqués."
	skipTarget="titre-projets"
>
	<WindowFrame title="Tous les projets" parent={{ href: `${withBase('/')}#projets`, label: 'Projets' }}>
		<div class="all-projects">
			<h1 id="titre-projets" tabindex="-1" class="ds-h1">Tous les projets</h1>
			<p class="intro ds-body-m">
				Les {projects.length} études de cas, regroupées par domaine : projets professionnels, académiques et de formation.
			</p>
			{groups.map((group) => (
				<section aria-labelledby={`famille-${group.category}`}>
					<h2 id={`famille-${group.category}`} class="ds-h2">{group.label}</h2>
					<ul class="grid">
						{group.projects.map(({ id, data }) => (
							<li>
								<ProjectCard
									slug={id}
									href={projectPath(id)}
									title={data.title}
									tags={data.tags}
									stack={data.stack}
									description={data.description}
									imageSrc={withBase(data.image)}
									imageAlt={data.imageAlt}
								/>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</WindowFrame>
	<!--
		Retour depuis une étude de cas (lien « Tous les projets ») : la page s'ouvre sur la carte
		du projet quitté, avant le premier rendu (script en ligne, après la grille). Un retour
		arrière du navigateur garde sa propre position de défilement.
	-->
	<script is:inline>
		(function () {
			try {
				var entry = performance.getEntriesByType('navigation')[0];
				if (entry && entry.type !== 'navigate') return;
				var from = (window.navigation && navigation.activation && navigation.activation.from && navigation.activation.from.url) || document.referrer;
				if (!from) return;
				var url = new URL(from);
				var match = url.origin === location.origin && url.pathname.match(/\/projets\/([^/.]+)(?:\.html)?\/?$/);
				var card = match && document.querySelector('[data-project-card="' + match[1] + '"]');
				if (card) card.scrollIntoView({ block: 'center', behavior: 'instant' });
			} catch (e) {}
		})();
	</script>
</BaseLayout>

<script>
	// Les cartes sont rendues sans JavaScript : comme dans le carrousel (ProjectCard), la carte
	// cliquée reçoit `data-transition` pour se transformer en fenêtre de l’étude de cas.
	document.addEventListener('click', (event) => {
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		const link = event.target instanceof Element ? event.target.closest('[data-project-card] a') : null;
		if (!link) return;
		document.querySelectorAll('[data-project-card][data-transition]').forEach((node) => {
			node.removeAttribute('data-transition');
		});
		link.closest('[data-project-card]')?.setAttribute('data-transition', '');
	});
</script>

<style>
	.all-projects {
		display: grid;
		gap: var(--spacing-8);
	}

	h1,
	.intro {
		margin: 0;
	}

	h1 {
		color: var(--text-heading);
	}

	.intro {
		margin-top: calc(-1 * var(--spacing-5));
		color: var(--text-secondary);
	}

	section {
		display: grid;
		gap: var(--spacing-5);
	}

	h2 {
		margin: 0;
		color: var(--text-heading);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: var(--spacing-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.grid li {
		display: flex;
		--project-card-max-width: none;
	}
</style>
