<section id="cyclist-game" class="game" data-cyclist-game hidden aria-labelledby="cyclist-game-title" aria-describedby="cyclist-game-intro">
	<header>
		<h2 id="cyclist-game-title" class="ds-h2">Le parcours à vélo</h2>
		<button type="button" class="close" data-close aria-label="Fermer le jeu"><span aria-hidden="true">×</span></button>
	</header>

	<p id="cyclist-game-intro">Tape les lettres du mot posé sur la route pour le franchir. Échap permet de quitter la partie. Deux mots réussis d’affilée font passer du vélo au longboard, puis au hoverboard ; chaque obstacle manqué fait redescendre d’un cran. À vélo, il coûte une sacoche, puis le vélo devient un monocycle. Des mots bonus passent sur les collines : les taper rend une sacoche, ou fait monter d’un cran. La météo change à chaque partie : la pluie masque des lettres, le verglas fait déraper à chaque faute. Chaque partie cache aussi un obstacle spécial : du verre brisé qui fait crever, un ours endormi à passer lentement ou, pendant l’orage, un arbre tombé. Une fois par partie, un train propose le mot : flèche droite pour l’accepter, mais relis-le, il peut se tromper.</p>

	<div class="start" data-game-start>
		<button type="button" data-start="timed">Jouer · 5 s par mot</button>
		<button type="button" data-start="untimed">Jouer sans chrono</button>
	</div>

	<div data-game-round hidden>
		<p class="visually-hidden" data-prompt id="cyclist-game-word"></p>
		<label class="visually-hidden" for="cyclist-game-input">Tape le mot sur la route</label>
		<input class="visually-hidden" id="cyclist-game-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="cyclist-game-word" />
		<button type="button" data-skip>Passer le mot</button>
		<button type="button" data-accept hidden>Accepter la suggestion (→)</button>
	</div>

	<p class="announcement" role="status"></p>
	<div data-game-result hidden>
		<h3 tabindex="-1" class="ds-h3" data-result></h3>
		<button type="button" data-replay>Rejouer</button>
	</div>
</section>

<script>
	import { createGameLandscape, midPlaneSpeed } from "../game-landscape";
	import { homeTechs } from "../data/skills";
	import { isTooFast, pickSpecial, specialInitials, specialWords, type Special, type SpecialKind } from "../game-specials";

	const obstacles = ['web', 'grille', 'clavier', 'prototype', 'contraste'];
	/*
	 * Échelle des montures. Départ à vélo avec deux sacoches (niveau 0) ; en dessous, la règle
	 * des sacoches puis du monocycle. On ne monte qu’à partir du vélo complet.
	 */
	const levels = {
		unicycle: -3,
		bike: 0,
		longboard: 1,
		hoverboard: 2
	} as const;
	const climbStreak = 2; // Mots réussis d’affilée pour monter d’un niveau.
	const mountOf = (level: number) => level === levels.longboard ? 'longboard' : level === levels.hoverboard ? 'hoverboard' : undefined;

	/*
	 * Train-suggestion : une fois par partie, un train passe sur le plan du milieu et propose le mot
	 * en cours. Une fois sur deux, la proposition contient une faute de frappe : l’accepter sans
	 * relire compte comme un obstacle manqué.
	 */
	const suggestionErrorRate = 0.5;
	const suggestionDelay = 0.12; // Part du mot écoulée avant que le train n’affiche sa suggestion.
	// Vers la fin du parcours : l’avant-dernier mot, les rails entrant dès le mot précédent.
	const suggestionRound = obstacles.length - 2;
	const railsRound = suggestionRound - 1;
	// Inverse deux lettres voisines différentes, hors première lettre : « prototype » → « prototpye ».
	const misspell = (word: string) => {
		const positions = Array.from({ length: word.length - 2 }, (_, i) => i + 1).filter(i => word[i] !== word[i + 1]);
		if (!positions.length) return word;
		const i = positions[Math.floor(Math.random() * positions.length)];
		return word.slice(0, i) + word[i + 1] + word[i] + word.slice(i + 2);
	};
	/*
	 * Mots bonus : des technologies du profil passent sur les collines du plan du milieu. Les taper
	 * avant qu’elles sortent de l’écran fait remonter d’un cran (sacoche, roue ou planche). Leur
	 * première lettre diffère de celle de tous les mots de la route : elle suffit à choisir la cible.
	 */
	const bonusRounds = [1, 2]; // Mots de la route pendant lesquels un mot bonus apparaît.
	// Entrée juste après le bord droit ; plus loin quand la gare entre au même moment, pour ne pas la croiser.
	const bonusOffset = (round: number) => round === railsRound ? 160 : 10;
	const roadInitials = new Set(obstacles.map(word => word[0]));
	const bonusWords = homeTechs.map(tech => tech.label).filter(label => {
		const initial = label[0].toLocaleLowerCase('fr');
		return !roadInitials.has(initial) && !specialInitials.has(initial);
	});
	/*
	 * Obstacles spéciaux : un par partie, à la place du 2e ou du 3e mot (avant la gare et le train).
	 * Verre brisé : raté à vélo ou en monocycle, le pneu crève (plus de montée tant qu’il n’est pas
	 * réparé) ; les planches n’ont rien à craindre. Ours endormi : il faut taper lentement. Arbre
	 * tombé (orage) : mot plus long, sauf en hoverboard qui le survole.
	 */
	const specialRounds = [1, 2];
	/*
	 * Météo, tirée au début de chaque partie. Elle gêne la lecture (pluie) ou la frappe (verglas),
	 * jamais la direction ; l’orage n’est qu’une ambiance. Le hoverboard flotte au-dessus du verglas,
	 * le longboard glisse sur la route mouillée.
	 */
	const weathers = ['clear', 'rain', 'ice', 'storm'] as const;
	type Weather = typeof weathers[number];
	const weatherIntro: Record<Weather, string> = {
		clear: 'Météo : temps clair.',
		rain: 'Météo : pluie. Des gouttes masquent parfois une lettre, et le longboard glisse sur la route mouillée.',
		ice: 'Météo : verglas. Une faute fait aussi perdre la dernière lettre validée, sauf en hoverboard.',
		storm: 'Météo : orage. Des éclairs au loin, sans effet sur la conduite.'
	};
	const weatherArrival: Record<Weather, string> = { clear: '', rain: ' sous la pluie', ice: ' sur le verglas', storm: ' sous l’orage' };
	const roundDuration = 5000;
	const wheelRadius = 11; // Rayon des roues dans le repère du SVG.
	const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
	const launch = document.querySelector<HTMLButtonElement>('[data-game-launch]');
	const settings = launch?.closest<HTMLElement>('#portfolio-settings');
	const settingsButton = document.querySelector<HTMLButtonElement>('[popovertarget="portfolio-settings"]');
	const game = document.querySelector<HTMLElement>('[data-cyclist-game]');
	const hero = game?.closest<HTMLElement>('.hero');
	const land = hero?.querySelector<SVGSVGElement>('svg.land');
	const hazard = land?.querySelector<SVGGElement>('[data-game-obstacle]');
	const desktop = matchMedia('(min-width: 64rem) and (any-pointer: fine)');
	const start = game?.querySelector<HTMLElement>('[data-game-start]');
	const round = game?.querySelector<HTMLElement>('[data-game-round]');
	const result = game?.querySelector<HTMLElement>('[data-game-result]');
	const resultTitle = game?.querySelector<HTMLElement>('[data-result]');
	const input = game?.querySelector('input');
	const prompt = game?.querySelector<HTMLElement>('[data-prompt]');
	const announcement = game?.querySelector<HTMLElement>('.announcement');
	const acceptButton = game?.querySelector<HTMLButtonElement>('[data-accept]');
	const train = land?.querySelector<SVGGElement>('[data-game-train]');
	const rails = land?.querySelector<SVGLineElement>('.game-rails');
	const station = land?.querySelector<SVGGElement>('[data-game-station]');
	const trainLabel = train?.querySelector<SVGTextElement>('.train-suggestion');
	const bonusText = land?.querySelector<SVGTextElement>('[data-game-bonus]');
	const bolt = land?.querySelector<SVGPathElement>('[data-game-bolt]');
	const strike = land?.querySelector<SVGPathElement>('[data-game-strike]');
	const chaseBear = land?.querySelector<SVGGElement>('[data-game-bear-chase]');
	const repairText = land?.querySelector<SVGTextElement>('[data-game-repair]');
	if (launch && game && hero && land && hazard && start && round && result && resultTitle && input && prompt && announcement && acceptButton && train && trainLabel && rails && station && bonusText && bolt && strike && chaseBear && repairText) {
		let index = 0;
		// Distance parcourue à l’entrée des rails ; undefined avant leur apparition.
		let railsFrom: number | undefined;
		// Décalage d’entrée des rails, fixé à leur première image pour laisser passer un mot bonus encore proche du bord.
		let railsOffset: number | undefined;
		// Suggestion du mot en cours : texte proposé, et s’il est déjà affiché.
		let suggestion: { text: string; correct: boolean; shown: boolean } | undefined;
		// Mot bonus affiché : libellé, mot à taper, distance à son entrée et largeur.
		let bonus: { label: string; word: string; from: number; offset: number; width: number } | undefined;
		// Mot visé par la saisie : celui de la route, le mot bonus, ou la réparation du pneu.
		let target: 'road' | 'bonus' | 'repair' = 'road';
		// Mot de la route en cours (un obstacle spécial remplace l’un d’eux) et lettres déjà validées.
		let roadWord = '';
		let roadMatched = 0;
		let special: Special | undefined;
		let flat = false;
		// Ours : heure de la dernière lettre acceptée, alerte déjà donnée, début de la poursuite.
		let bearLetterAt: number | undefined;
		let bearWarned = false;
		let chaseFrom: number | undefined;
		let strikeUntil = 0;
		let usedBonuses: string[] = [];
		let weather: Weather = 'clear';
		// Prochaine goutte sur une lettre (pluie) et prochain éclair (orage), en temps de requestAnimationFrame.
		let nextDrop = 0;
		let dropUntil = 0;
		let nextFlash = 0;
		let flashUntil = 0;
		let missed = 0;
		let level: number = levels.bike;
		let streak = 0;
		let timed = true;
		let frame = 0;
		let deadline = 0;
		let renderedProgress = 0;
		const landscape = createGameLandscape(land);
		let distance = 0;
		let previousTime = 0;

		const svg = 'http://www.w3.org/2000/svg';
		const lettering = document.createElementNS(svg, 'text');
		lettering.classList.add('road-word');
		lettering.setAttribute('y', '-3');
		hazard.append(lettering);
		let wordWidth = 0;
		const droppedBags: { element: SVGRectElement; startDistance: number }[] = [];
		let looseWheel: { element: SVGGElement; releasedAt: number; initialAngle: number } | undefined;

		const clearDroppedParts = () => {
			for (const { element } of droppedBags) element.remove();
			droppedBags.length = 0;
			looseWheel?.element.remove();
			looseWheel = undefined;
		};

		const releaseWheel = () => {
			const rim = land.querySelector('.bike-frame > circle[cx="20"]');
			const spokes = land.querySelector('.bike-frame > .spokes:has(circle[cx="20"])');
			if (!rim || !spokes) return;
			const element = document.createElementNS(svg, 'g');
			element.setAttribute('data-loose-wheel', '');
			element.setAttribute('fill', 'none');
			element.setAttribute('stroke', 'var(--scene-bike)');
			element.setAttribute('stroke-width', '2.5');
			const spinningSpokes = spokes.cloneNode(true) as SVGGElement;
			spinningSpokes.removeAttribute('class');
			element.append(rim.cloneNode(), spinningSpokes);
			hazard.before(element);
			looseWheel = { element, releasedAt: performance.now(), initialAngle: distance / wheelRadius };
		};

		const dropBag = (bag: SVGRectElement | null) => {
			if (!bag) return;
			const element = bag.cloneNode() as SVGRectElement;
			element.removeAttribute('class');
			element.setAttribute('data-dropped-bag', '');
			hazard.before(element);
			droppedBags.push({ element, startDistance: distance });
		};

		// Affiche la suggestion au-dessus du train. Dès l’apparition du mot, elle complète son annonce.
		const revealSuggestion = (withWord: boolean) => {
			if (!suggestion) return;
			suggestion.shown = true;
			trainLabel.textContent = `${suggestion.text} ?`;
			acceptButton.hidden = false;
			const message = `Le train propose : ${suggestion.text}. Flèche droite pour accepter.`;
			announcement.textContent = withWord && announcement.textContent ? `${announcement.textContent} ${message}` : message;
		};

		const clearSuggestion = () => {
			suggestion = undefined;
			hero.removeAttribute('data-game-train');
			trainLabel.textContent = '';
			acceptButton.hidden = true;
		};

		const paintLetters = (text: SVGTextElement, matched: number, retry: boolean) => {
			Array.from(text.children).forEach((letter, i) => {
				letter.classList.toggle('matched', i < matched);
				letter.classList.toggle('retry', retry && i === matched);
			});
		};

		const setLetters = (text: SVGTextElement, word: string) => {
			text.replaceChildren(...Array.from(word, char => {
				const letter = document.createElementNS(svg, 'tspan');
				letter.textContent = char;
				return letter;
			}));
		};

		const isSpecialRound = (kind?: SpecialKind) => special !== undefined && index === special.round && (!kind || special.kind === kind);

		// Mot de la route : un obstacle spécial remplace le mot prévu ; l’arbre se survole en hoverboard.
		const wordFor = (round: number) => {
			if (!special || round !== special.round) return obstacles[round];
			if (special.kind === 'tree') return level === levels.hoverboard ? specialWords.treeHover : specialWords.tree;
			return specialWords[special.kind];
		};

		const specialIntro = () => {
			if (!special) return '';
			if (special.kind === 'glass') {
				return `Du verre brisé sur la route : tape « ${specialWords.glass} » pour passer.${level > levels.bike ? ' Les roues de ta planche ne crèvent pas.' : ' Si tu le rates, tu crèves.'}`;
			}
			if (special.kind === 'bear') {
				return `Un ours dort au bord du chemin : tape « ${specialWords.bear} » lentement, une lettre à la fois, sinon il se réveille.`;
			}
			return `Un éclair a frappé un arbre : un tronc barre la route.${level === levels.hoverboard ? ` En hoverboard, tu le survoles : tape « ${specialWords.treeHover} ».` : ` Tape « ${specialWords.tree} » pour le franchir.`}`;
		};

		// Pneu crevé : plus de montée de cran tant que « rustine » n’est pas tapé.
		const setFlat = (value: boolean) => {
			flat = value;
			if (value) {
				hero.dataset.gameFlat = '';
				setLetters(repairText, specialWords.repair);
				repairText.append(' ?');
			} else {
				hero.removeAttribute('data-game-flat');
				repairText.replaceChildren();
				if (target === 'repair') target = 'road';
			}
		};

		const repairTire = () => {
			setFlat(false);
			input.value = '';
			roadMatched = 0;
			paintLetters(lettering, 0, false);
			announcement.textContent = `Pneu réparé ! Tu peux de nouveau monter. Mot en cours : ${roadWord}.`;
		};

		const endChase = () => {
			chaseFrom = undefined;
			hero.removeAttribute('data-game-chase');
		};

		// Remet à zéro les obstacles spéciaux (début et fin de partie).
		const clearSpecials = () => {
			special = undefined;
			setFlat(false);
			endChase();
			strikeUntil = 0;
			for (const name of ['data-game-obstacle', 'data-game-bear', 'data-game-strike']) hero.removeAttribute(name);
		};

		const showBonus = (feedback: string) => {
			const available = bonusWords.filter(label => !usedBonuses.includes(label));
			if (!available.length) return feedback;
			const label = available[Math.floor(Math.random() * available.length)];
			usedBonuses.push(label);
			setLetters(bonusText, label);
			hero.dataset.gameBonus = '';
			bonus = { label, word: label.toLocaleLowerCase('fr'), from: distance, offset: bonusOffset(index), width: bonusText.getComputedTextLength() };
			prompt.textContent += ` · Mot bonus : ${label}`;
			return `${feedback} Mot bonus sur les collines : ${label}.`.trim();
		};

		const clearBonus = () => {
			if (target === 'bonus') {
				input.value = '';
				paintLetters(lettering, 0, false);
				roadMatched = 0;
				target = 'road';
			}
			bonus = undefined;
			hero.removeAttribute('data-game-bonus');
			bonusText.replaceChildren();
			prompt.textContent = prompt.textContent.replace(/ · Mot bonus : .*$/, '');
		};

		// Un mot bonus attrapé fait remonter d’un cran : sacoche ou roue retrouvée, puis planche.
		const catchBonus = () => {
			if (!bonus) return;
			const { label } = bonus;
			if (flat) {
				clearBonus();
				input.value = '';
				roadMatched = 0;
				paintLetters(lettering, 0, false);
				announcement.textContent = `Mot bonus attrapé : ${label}, mais ton pneu est crevé : tape « ${specialWords.repair} » pour le réparer avant de remonter. Mot en cours : ${roadWord}.`;
				return;
			}
			const previous = level;
			level = Math.min(levels.hoverboard, level + 1);
			showLevel();
			clearBonus();
			input.value = '';
			paintLetters(lettering, 0, false);
			const change = previous === levels.unicycle ? 'Le monocycle redevient un vélo.' :
				previous < levels.bike ? 'Une sacoche retrouvée.' :
				level === levels.longboard ? 'Tu passes au longboard !' :
				level === levels.hoverboard && previous !== level ? 'Tu passes en hoverboard !' : 'Tu es déjà au sommet.';
			input.value = '';
			roadMatched = 0;
			announcement.textContent = `Mot bonus attrapé : ${label} ! ${change} Mot en cours : ${roadWord}.`;
		};

		const clearRails = () => {
			railsFrom = undefined;
			railsOffset = undefined;
			hero.removeAttribute('data-game-rails');
		};

		const draw = (progress: number) => {
			renderedProgress = progress;
			const reduced = document.documentElement.hasAttribute('data-reduced-motion') || motionPreference.matches;
			const matrix = land.getScreenCTM();
			if (!matrix) return;
			const bounds = land.getBoundingClientRect();
			const riderX = (bounds.left + bounds.width / 4 - matrix.e) / matrix.a;
			const roadsideX = (bounds.left + bounds.width * 0.94 - matrix.e) / matrix.a - wordWidth;
			const obstacleX = reduced ? roadsideX : roadsideX - (roadsideX - riderX - 28) * progress;
			hero.style.setProperty('--game-rider-x', `${riderX}px`);
			if (!reduced && distance > 0) landscape.draw(distance);
			hero.style.setProperty('--game-wheel-angle', `${distance / wheelRadius}rad`);
			hazard.setAttribute('transform', `translate(${obstacleX} ${land.dataset.horizonY})`);
			const sceneX = (share: number) => (bounds.left + bounds.width * share - matrix.e) / matrix.a;
			// Les rails (et leur gare) commencent au bord droit et défilent avec le plan du milieu ; fixes en mouvement réduit.
			let railsX = -Infinity;
			if (railsFrom !== undefined) {
				if (railsOffset === undefined) {
					const bonusRight = bonus && !reduced ? sceneX(1) + bonus.offset - (distance - bonus.from) * midPlaneSpeed + bonus.width : -Infinity;
					railsOffset = Math.max(20, bonusRight + 30 - sceneX(1));
				}
				railsX = reduced ? sceneX(0.4) : sceneX(1) + railsOffset - (distance - railsFrom) * midPlaneSpeed;
				rails.setAttribute('x1', String(railsX));
				rails.setAttribute('x2', String(railsX + 3000));
				station.setAttribute('transform', `translate(${railsX} 229)`);
			}
			if (suggestion) {
				// Le train entre par la droite et traverse le plan du milieu, sans dépasser la gare au début des rails ;
				// en mouvement réduit, il attend directement en gare.
				const trainX = Math.max(sceneX(reduced ? 0.4 : 1 - 0.75 * progress), railsX + 6);
				train.setAttribute('transform', `translate(${trainX} 228)`);
				if (!suggestion.shown && (reduced || progress >= suggestionDelay)) revealSuggestion(progress === 0);
			}
			if (bonus) {
				// Le mot bonus défile avec les collines ; fixe en mouvement réduit, jusqu’au mot suivant.
				const bonusX = reduced ? sceneX(0.7) : sceneX(1) + bonus.offset - (distance - bonus.from) * midPlaneSpeed;
				if (bonusX + bonus.width < sceneX(0)) clearBonus();
				else bonusText.setAttribute('x', String(bonusX));
			}
			const groundY = Number(land.dataset.horizonY);
			// L’éclair qui frappe l’arbre tombe à droite, là où le tronc va entrer.
			strike.setAttribute('transform', `translate(${sceneX(0.86)} 0)`);
			repairText.setAttribute('x', String(riderX));
			if (chaseFrom !== undefined) {
				// L’ours court derrière le cycliste, puis renonce et repart vers la gauche.
				const elapsed = performance.now() - chaseFrom;
				if (reduced || elapsed > 4500) endChase();
				else chaseBear.setAttribute('transform', `translate(${riderX - 58 - Math.max(0, elapsed - 1800) * 0.15} ${groundY})`);
			}
			if (looseWheel) {
				const { element, releasedAt, initialAngle } = looseWheel;
				const elapsed = reduced ? 0 : Math.max(0, performance.now() - releasedAt);
				const x = riderX - elapsed * 0.12;
				if (matrix.e + (x + 20 + wheelRadius) * matrix.a < bounds.left) {
					element.remove();
					looseWheel = undefined;
				} else {
					// La roue tourne encore vers l’avant, mais moins vite que le cycliste.
					const angle = (initialAngle + elapsed * 0.06 / wheelRadius) * 180 / Math.PI;
					element.setAttribute('transform', `translate(${x} ${groundY}) rotate(${angle} 20 -11)`);
				}
			}
			for (const { element, startDistance } of droppedBags) {
				const travelled = distance - startDistance;
				const settled = reduced || round.hidden;
				const drift = settled ? Math.max(travelled, 32) : travelled;
				const progress = settled ? 1 : Math.min(1, travelled / 55);
				const drop = 1 + (progress * progress) * (-element.y.baseVal.value - element.height.baseVal.value);
				element.setAttribute('transform', `translate(${riderX - drift} ${groundY + drop})`);
			}
		};

		const showStart = () => {
			cancelAnimationFrame(frame);
			index = 0;
			distance = 0;
			clearDroppedParts();
			landscape.reset();
			missed = 0;
			level = levels.bike;
			streak = 0;
			showLevel();
			clearSuggestion();
			clearRails();
			clearBonus();
			usedBonuses = [];
			clearSpecials();
			setWeather('clear');
			lettering.replaceChildren();
			start.hidden = false;
			round.hidden = true;
			result.hidden = true;
			announcement.textContent = '';
			draw(0);
		};

		// Sacoches et monocycle (data-game-missed) sous le vélo complet, planche (data-game-mount) au-dessus.
		const showLevel = () => {
			hero.dataset.gameMissed = String(Math.max(0, levels.bike - level));
			const mount = mountOf(level);
			if (mount) hero.dataset.gameMount = mount;
			else hero.removeAttribute('data-game-mount');
		};

		const describeChange = (success: boolean, previous: number) => {
			if (success) {
				if (level === previous) return 'Obstacle franchi.';
				return level === levels.hoverboard ? 'Obstacle franchi. Tu passes en hoverboard !' : 'Obstacle franchi. Tu passes au longboard !';
			}
			if (previous === levels.hoverboard) return 'Obstacle manqué. Retour au longboard.';
			if (previous === levels.longboard && level < levels.bike) return 'Obstacle manqué. Le longboard glisse sur la route mouillée : retour au vélo, une sacoche en moins.';
			if (previous === levels.longboard) return 'Obstacle manqué. Retour au vélo.';
			if (previous > levels.bike - 2) return 'Obstacle manqué. Une sacoche en moins.';
			if (previous === levels.bike - 2) return 'Obstacle manqué. Le vélo devient un monocycle !';
			return 'Obstacle manqué.';
		};

		const finishObstacle = (success: boolean, note = '') => {
			cancelAnimationFrame(frame);
			clearSuggestion();
			const previous = level;
			// Le verre brisé raté à vélo ou en monocycle crève le pneu au lieu de faire perdre un cran.
			const punctures = !success && isSpecialRound('glass') && level <= levels.bike && !flat;
			hero.removeAttribute('data-game-bear');
			if (success) {
				streak += 1;
				if (streak >= climbStreak && !flat && level >= levels.bike && level < levels.hoverboard) {
					level += 1;
					streak = 0;
				}
			} else if (punctures) {
				missed += 1;
				streak = 0;
				setFlat(true);
			} else {
				missed += 1;
				streak = 0;
				// Les pièces perdues tombent avant que le nouvel état ne les masque.
				if (level === levels.bike) dropBag(land.querySelector<SVGRectElement>('.game-bag-one'));
				else if (level === levels.bike - 1) dropBag(land.querySelector<SVGRectElement>('.game-bag-two'));
				else if (level === levels.bike - 2) releaseWheel();
				const slides = weather === 'rain' && level === levels.longboard;
				level = Math.max(levels.unicycle, level - 1);
				// Sous la pluie, le longboard glisse : un cran de plus, la première sacoche tombe.
				if (slides) {
					dropBag(land.querySelector<SVGRectElement>('.game-bag-one'));
					level -= 1;
				}
			}
			showLevel();
			index += 1;

			if (index === obstacles.length) {
				clearBonus();
				endChase();
				for (const name of ['data-game-flash', 'data-game-obstacle', 'data-game-strike']) hero.removeAttribute(name);
				lettering.replaceChildren();
				round.hidden = true;
				draw(0);
				result.hidden = false;
				const score = obstacles.length - missed;
				const arrival = level === levels.hoverboard ? 'en hoverboard' :
					level === levels.longboard ? 'en longboard' :
					level === levels.unicycle ? 'en monocycle' : 'à vélo';
				resultTitle.textContent = `${score} obstacle${score === 1 ? '' : 's'} franchi${score === 1 ? '' : 's'} sur ${obstacles.length}, arrivée ${arrival}${weatherArrival[weather]}${flat ? ', pneu crevé' : ''} !`;
				announcement.textContent = '';
				resultTitle.focus({ preventScroll: true });
				if (looseWheel) frame = requestAnimationFrame(tick);
				return;
			}

			const change = punctures
				? `Obstacle manqué : crevaison ! Tape « ${specialWords.repair} » pour réparer ; en attendant, tu ne peux plus monter.`
				: describeChange(success, previous);
			showObstacle(note ? `${note} ${change}` : change);
		};

		const setWeather = (next: Weather) => {
			weather = next;
			if (next === 'clear') hero.removeAttribute('data-game-weather');
			else hero.dataset.gameWeather = next;
			hero.removeAttribute('data-game-flash');
			const now = performance.now();
			nextDrop = now + 1200;
			dropUntil = 0;
			nextFlash = now + 2500;
			flashUntil = 0;
		};

		// Effets animés de la météo, absents en mouvement réduit (aucun clignotement).
		const updateWeather = (now: number) => {
			if (strikeUntil && now >= strikeUntil) {
				hero.removeAttribute('data-game-strike');
				strikeUntil = 0;
			}
			if (weather === 'rain') {
				if (dropUntil && now >= dropUntil) {
					lettering.querySelector('.drenched')?.classList.remove('drenched');
					dropUntil = 0;
				}
				if (now >= nextDrop) {
					// Une goutte masque brièvement une lettre pas encore tapée.
					const dry = Array.from(lettering.children).filter(letter => !letter.classList.contains('matched'));
					dry[Math.floor(Math.random() * dry.length)]?.classList.add('drenched');
					dropUntil = now + 450;
					nextDrop = now + 900 + Math.random() * 700;
				}
			}
			if (weather === 'storm') {
				if (flashUntil && now >= flashUntil) {
					hero.removeAttribute('data-game-flash');
					flashUntil = 0;
				}
				if (now >= nextFlash) {
					// Un seul éclair bref et lointain toutes les 5 à 10 s, jamais tout l’écran.
					bolt.setAttribute('transform', `translate(${200 + Math.random() * 1040} 0)`);
					hero.dataset.gameFlash = '';
					flashUntil = now + 140;
					nextFlash = now + 5000 + Math.random() * 5000;
				}
			}
		};

		const tick = (now: number) => {
			const reduced = document.documentElement.hasAttribute('data-reduced-motion') || motionPreference.matches;
			if (round.hidden) {
				draw(0);
				if (looseWheel && !reduced) frame = requestAnimationFrame(tick);
				return;
			}
			if (!reduced) {
				distance += Math.min(now - previousTime, 64) * 0.18;
				updateWeather(now);
			}
			previousTime = now;
			const elapsed = Math.min(1, Math.max(0, 1 - (deadline - now) / roundDuration));
			// Sans chrono, le mot ralentit puis attend devant la roue.
			draw(timed ? elapsed : Math.sin(elapsed * Math.PI / 2));
			if (timed && elapsed === 1) finishObstacle(false);
			else frame = requestAnimationFrame(tick);
		};

		const showObstacle = (feedback = '') => {
			const obstacle = wordFor(index);
			roadWord = obstacle;
			const reduced = document.documentElement.hasAttribute('data-reduced-motion') || motionPreference.matches;
			// En mouvement réduit, le mot bonus ne défile pas : il disparaît au mot suivant.
			if (reduced) clearBonus();
			target = 'road';
			roadMatched = 0;
			bearLetterAt = undefined;
			bearWarned = false;
			if (special && isSpecialRound()) {
				hero.dataset.gameObstacle = special.kind;
				feedback = `${feedback} ${specialIntro()}`.trim();
				if (special.kind === 'tree' && !reduced) {
					// Un seul éclair bref, à la place du prochain éclair lointain.
					const now = performance.now();
					hero.dataset.gameStrike = '';
					strikeUntil = now + 180;
					nextFlash = now + 5000;
				}
			} else {
				hero.removeAttribute('data-game-obstacle');
			}
			prompt.textContent = `Mot ${index + 1} sur ${obstacles.length} · ${obstacle}`;
			lettering.replaceChildren(...Array.from(obstacle.toUpperCase(), char => {
				const letter = document.createElementNS(svg, 'tspan');
				letter.textContent = char;
				return letter;
			}));
			wordWidth = lettering.getComputedTextLength();
			input.value = '';
			if (bonusRounds.includes(index) && !bonus) feedback = showBonus(feedback);
			else if (bonus) prompt.textContent += ` · Mot bonus : ${bonus.label}`;
			draw(0);
			if (document.activeElement === input && feedback) {
				announcement.textContent = `${feedback} Mot suivant : ${obstacle}.`;
			} else {
				announcement.textContent = feedback;
				input.focus({ preventScroll: true });
			}
			if (index === railsRound) {
				railsFrom = distance;
				railsOffset = undefined;
				hero.dataset.gameRails = '';
				draw(0);
			}
			if (index === suggestionRound) {
				const text = Math.random() < suggestionErrorRate ? misspell(obstacle) : obstacle;
				suggestion = { text, correct: text === obstacle, shown: false };
				hero.dataset.gameTrain = '';
				draw(0);
			}
			previousTime = performance.now();
			deadline = previousTime + roundDuration;
			frame = requestAnimationFrame(tick);
		};

		const close = (restoreFocus: boolean) => {
			cancelAnimationFrame(frame);
			game.hidden = true;
			hero.removeAttribute('data-playing');
			hero.removeAttribute('data-game-missed');
			hero.removeAttribute('data-game-mount');
			clearSuggestion();
			clearRails();
			clearBonus();
			clearSpecials();
			setWeather('clear');
			lettering.replaceChildren();
			clearDroppedParts();
			hero.style.removeProperty('--game-rider-x');
			landscape.reset();
			hero.style.removeProperty('--game-wheel-angle');
			launch.hidden = !desktop.matches;
			if (restoreFocus) settingsButton?.focus({ preventScroll: true });
		};

		const syncAvailability = () => {
			if (!desktop.matches && !game.hidden) close(false);
			launch.hidden = !desktop.matches || !game.hidden;
		};
		syncAvailability();
		desktop.addEventListener('change', syncAvailability);
		const refreshScene = () => {
			if (!game.hidden) draw(renderedProgress);
		};
		window.addEventListener('resize', refreshScene, { passive: true });
		new MutationObserver(refreshScene).observe(document.documentElement, {
			attributes: true, attributeFilter: ['data-reduced-motion']
		});

		launch.addEventListener('click', () => {
			settings?.hidePopover();
			window.scrollTo({ top: 0, behavior: 'instant' });
			launch.hidden = true;
			game.hidden = false;
			hero.setAttribute('data-playing', '');
			showStart();
			game.querySelector<HTMLElement>('[data-close]')?.focus({ preventScroll: true });
		});
		game.querySelector('[data-close]')?.addEventListener('click', () => close(true));
		game.addEventListener('keydown', event => {
			if (event.key === 'Escape') close(true);
		});
		new MutationObserver(() => {
			if (!game.hidden && document.documentElement.dataset.section !== 'accueil') close(false);
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-section'] });

		game.querySelectorAll<HTMLButtonElement>('[data-start]').forEach(button => {
			button.addEventListener('click', () => {
				timed = button.dataset.start === 'timed';
				start.hidden = true;
				round.hidden = false;
				setWeather(weathers[Math.floor(Math.random() * weathers.length)]);
				special = pickSpecial(weather === 'storm', specialRounds);
				showObstacle(weatherIntro[weather]);
			});
		});
		game.querySelector('[data-replay]')?.addEventListener('click', () => {
			showStart();
			start.querySelector('button')?.focus({ preventScroll: true });
		});
		game.querySelector('[data-skip]')?.addEventListener('click', () => finishObstacle(false));
		// Accepter la suggestion du train : juste, le mot est franchi ; fautive, c’est un obstacle manqué.
		const acceptSuggestion = () => {
			if (!suggestion?.shown) return;
			const { text, correct } = suggestion;
			finishObstacle(correct, correct ? 'Suggestion du train acceptée.' : `Suggestion fautive acceptée : ${text}.`);
		};
		acceptButton.addEventListener('click', acceptSuggestion);
		input.addEventListener('keydown', event => {
			if (event.key === 'ArrowRight' && suggestion?.shown) {
				event.preventDefault();
				acceptSuggestion();
			}
		});
		// Trop vite devant l’ours : une première fois il remue, la seconde il se réveille et poursuit le cycliste.
		const wakeBear = () => {
			const reduced = document.documentElement.hasAttribute('data-reduced-motion') || motionPreference.matches;
			if (!reduced) {
				chaseFrom = performance.now();
				hero.dataset.gameChase = '';
			}
			finishObstacle(false, reduced ? 'Trop vite : l’ours se réveille !' : 'Trop vite : l’ours se réveille et te poursuit !');
		};

		const updateLetters = () => {
			const word = roadWord;
			if (!word || round.hidden) return;
			const typed = input.value.toLocaleLowerCase('fr');
			// La première lettre choisit la cible : le mot bonus, la réparation du pneu, sinon la route.
			if (!typed) target = 'road';
			else if (target === 'road' && bonus && typed[0] === bonus.word[0]) target = 'bonus';
			else if (target === 'road' && flat && typed[0] === specialWords.repair[0]) target = 'repair';
			const goal = target === 'bonus' && bonus ? bonus.word : target === 'repair' ? specialWords.repair : word;
			const text = target === 'bonus' ? bonusText : target === 'repair' ? repairText : lettering;
			let matched = 0;
			while (matched < goal.length && typed[matched] === goal[matched]) matched++;
			const hasError = matched < typed.length;
			// Sur le verglas, une faute fait aussi perdre la dernière lettre validée ; le hoverboard flotte au-dessus.
			const slips = hasError && weather === 'ice' && level !== levels.hoverboard && matched > 0;
			if (slips) matched -= 1;
			// Devant l’ours, chaque nouvelle lettre doit laisser passer un peu de temps après la précédente.
			if (target === 'road' && isSpecialRound('bear') && !hasError && matched > roadMatched) {
				const now = performance.now();
				if (isTooFast(bearLetterAt, now, matched - roadMatched)) {
					if (bearWarned) {
						wakeBear();
						return;
					}
					bearWarned = true;
					hero.dataset.gameBear = 'stirring';
					input.value = typed.slice(0, roadMatched);
					paintLetters(lettering, roadMatched, false);
					announcement.textContent = 'Doucement ! L’ours bouge une oreille. Une lettre à la fois.';
					return;
				}
				bearLetterAt = now;
			}
			// Keep the valid prefix so the next key can retry the missed letter.
			if (hasError) input.value = typed.slice(0, matched);
			const expected = hasError ? `${slips ? 'Dérapage sur le verglas ! ' : ''}Lettre attendue · ${goal[matched].toUpperCase()}` : '';
			paintLetters(text, matched, hasError);
			if (target === 'road') roadMatched = matched;
			if (matched === goal.length) {
				if (target === 'bonus') catchBonus();
				else if (target === 'repair') repairTire();
				else finishObstacle(true);
			} else if (hasError) announcement.textContent = expected;
		};
		input.addEventListener('input', event => {
			if (!(event instanceof InputEvent && event.isComposing)) updateLetters();
		});
		input.addEventListener('compositionend', updateLetters);
		hero.addEventListener('click', event => {
			if (game.hidden || round.hidden || !(event.target instanceof Element)) return;
			if (!event.target.closest('button, input, a')) input.focus({ preventScroll: true });
		});
	}
</script>

<style>
	.game {
		width: min(100%, 36rem);
		padding: clamp(1rem, 3vw, 1.5rem);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xl);
		background: var(--surface-elevated);
		color: var(--text-primary);
	}

	header, .start, .controls {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	header { justify-content: space-between; }
	h2, h3 { margin: 0; }
	p { color: var(--text-secondary); }

	.game button, input {
		min-height: 44px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		padding: var(--spacing-2) var(--spacing-3);
		background: var(--surface-subtle);
		color: var(--text-primary);
		font: inherit;
	}

	.game button { cursor: pointer; }
	.game button:hover { border-color: var(--action-primary); }
	.close { min-width: 44px; flex-shrink: 0; }

	.start, .controls { flex-wrap: wrap; margin-top: var(--spacing-4); }
	.visually-hidden, .game:has([data-game-round]:not([hidden])) :is(h2, .announcement) {
		position: absolute;
		width: 1px;
		height: 1px;
		min-height: 0;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
	}
	.game:has([data-game-round]:not([hidden])) {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		width: fit-content;
		padding: 0;
		border: 0;
		background: transparent;
	}
	.game:has([data-game-round]:not([hidden])) #cyclist-game-intro { display: none; }
	:global(.road-word) {
		font: 800 25px var(--font-sans);
		letter-spacing: 1px;
		fill: var(--text-primary);
		stroke: var(--surface-elevated);
		stroke-width: 3px;
		paint-order: stroke fill;
	}
	:global(.game-bonus) {
		font: 700 17px var(--font-sans);
		fill: var(--text-primary);
		stroke: var(--surface-elevated);
		stroke-width: 3px;
		paint-order: stroke fill;
	}
	:global(.game-bonus .matched) { fill: var(--action-primary); text-decoration: underline; }
	:global(.game-bonus .retry) { text-decoration: underline wavy; }
	:global(.train-suggestion) {
		font: 700 17px var(--font-sans);
		fill: var(--text-primary);
		stroke: var(--surface-elevated);
		stroke-width: 3px;
		paint-order: stroke fill;
	}
	:global(.road-word .matched) { fill: var(--action-primary); text-decoration: underline; }
	:global(.road-word .retry) { text-decoration: underline wavy; }
	/* Pluie : une goutte masque brièvement une lettre. */
	:global(.road-word .drenched) { fill-opacity: 0.12; stroke-opacity: 0.12; }
	:global(.hero:has(#cyclist-game-input:focus-visible) .road-word) {
		filter: drop-shadow(0 2px 1px var(--surface-elevated));
	}
	.announcement { margin: var(--spacing-3) 0 0; }
	[data-game-result] button { margin-top: var(--spacing-3); }
	[hidden] { display: none !important; }
</style>
