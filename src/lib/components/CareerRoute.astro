---
const careerSteps = [
	{
		id: 'webacademie',
		period: '2020–2022',
		name: 'Web@cadémie',
		detail: 'Formation en développement web, Nancy.'
	},
	{
		id: 'easysav',
		period: '2021–2025',
		name: 'EasySAV',
		detail: 'Développeur web en alternance, Metz.'
	},
	{
		id: 'epitech',
		period: '2022–2025',
		name: 'Epitech',
		detail:
			'Pré-MSc puis MSc IoT, Nancy. Titre obtenu : « Architecte logiciel, développeur d’applications », niveau\u00A07.'
	},
	{
		id: 'openclassrooms',
		period: 'Depuis 2026',
		name: 'OpenClassrooms',
		detail: 'Formation Product Designer, certification UX/UI Designer niveau\u00A06 en cours.'
	}
];
---
<script is:inline>
	document.documentElement.setAttribute('data-career-waiting', '');
</script>

<section class="career" aria-labelledby="parcours-title">
	<h3 id="parcours-title">Parcours</h3>
	<div class="road" aria-hidden="true">
		<div class="trail"></div>
		{careerSteps.map((_, i) => <i style={`left:${i * 100 / (careerSteps.length - 1)}%`}></i>)}
	</div>
	<ol>
		{careerSteps.map((step, i) => (
			<li style={`--delay:${i * 3.6 / (careerSteps.length - 1)}s`}>
				<p class="date">{step.period}</p>
				<p class="name">{step.name}</p>
				<p>{step.detail}</p>
			</li>
		))}
	</ol>
</section>

<script>
	const route = document.querySelector<HTMLElement>('.career');
	const road = route?.querySelector<HTMLElement>('.road');
	const hero = document.querySelector<HTMLElement>('.hero');
	const land = hero?.querySelector<SVGSVGElement>('svg[data-horizon-y]');
	const zoom = hero?.querySelector<HTMLElement>('.scene .zoom');
	const profile = route?.closest<HTMLElement>('.profil');
	const title = route?.querySelector('h3');
	if (route && road && hero && land && zoom && profile && title) {
		const html = document.documentElement;
		let frame = 0;
		const clearShortcut = () => html.removeAttribute('data-contact-shortcut');
		hero.querySelector('a[href="#contact"]')?.addEventListener('click', (event) => {
			if (html.hasAttribute('data-reduced-motion')) return;
			if (!(event instanceof MouseEvent) || event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
			const matrix = land.getScreenCTM();
			if (!matrix) return;
			const bounds = land.getBoundingClientRect();
			hero.style.setProperty('--contact-arrival', `${(bounds.left + bounds.width / 4 - matrix.e) / matrix.a}px`);
			const ground = new DOMPoint(0, Number(land.dataset.horizonY)).matrixTransform(matrix);
			const scene = zoom.getBoundingClientRect();
			hero.style.setProperty('--zoom-origin', `${bounds.left + bounds.width / 4 - scene.left}px ${ground.y - scene.top}px`);
			html.setAttribute('data-contact-shortcut', '');
		});
		// Si le défilement est interrompu avant Contact, rendre la main au parcours.
		window.addEventListener('scrollend', () => {
			if (html.dataset.section !== 'contact') {
				clearShortcut();
				schedule();
			}
		});
		const align = () => {
			frame = 0;
			if (html.hasAttribute('data-contact-shortcut') || html.hasAttribute('data-reduced-motion')) return;
			if (matchMedia('(max-width: 39.99rem)').matches) {
				if (html.hasAttribute('data-career-started')) {
					html.removeAttribute('data-career-started');
					html.setAttribute('data-career-finished', '');
				}
				return;
			}
			if (html.dataset.section !== 'profil') {
				if (html.hasAttribute('data-career-started')) {
					const rider = land.querySelector<SVGGElement>('.rider');
					if (rider && html.dataset.section === 'contact') {
						// Le groupe parent porte le déplacement en cours, figé à l’entrée de Contact.
						const movement = getComputedStyle(rider.parentElement!);
						const offset = parseFloat(movement.translate) || 0;
						hero.style.setProperty('--contact-start-opacity', movement.opacity);
						const end = parseFloat(getComputedStyle(rider).translate);
						hero.style.setProperty('--contact-stop', `${end + offset}px`);
					}
					html.removeAttribute('data-career-started');
					html.setAttribute('data-career-finished', '');
				}
				return;
			}
			// Au retour de Contact, attendre la fin du dézoom avant de mesurer
			// le paysage et de lancer ensemble le tracé et le cycliste.
			if ((parseFloat(getComputedStyle(zoom).scale) || 1) !== 1) {
				schedule();
				return;
			}
			// Positions et opacité figées à une arrivée sur Contact pendant le parcours : la
			// suivante, parcours fini, doit repartir d’un vélo caché.
			hero.style.removeProperty('--contact-stop');
			hero.style.removeProperty('--contact-start-opacity');
			const matrix = land.getScreenCTM();
			if (!matrix) return;
			const stops = road.getBoundingClientRect();
			const horizon = new DOMPoint(0, Number(land.dataset.horizonY)).matrixTransform(matrix);
			// À l’arrivée sur #profil, la carte s’aligne sur la marge de défilement.
			// Seule la frise réserve l’espace entre son titre et le sol du paysage.
			const inset = parseFloat(getComputedStyle(html).scrollPaddingTop) || 0;
			const titleBottom = title.getBoundingClientRect().bottom - profile.getBoundingClientRect().top;
			route.style.setProperty('--road-gap', `${Math.max(0, horizon.y - inset - titleBottom)}px`);
			const bounds = land.getBoundingClientRect();
			hero.style.setProperty('--contact-arrival', `${(bounds.left + bounds.width / 4 - matrix.e) / matrix.a}px`);
			// Les repères correspondent au passage de la roue avant (x = 20 dans le SVG).
			const frontWheel = 20;
			const wheelbase = 2 * frontWheel;
			hero.style.setProperty('--career-start', `${(stops.left - matrix.e) / matrix.a - frontWheel}px`);
			hero.style.setProperty('--career-end', `${(stops.right - matrix.e) / matrix.a - frontWheel}px`);
			route.style.setProperty('--wheelbase', `${wheelbase * matrix.a}px`);
			route.style.setProperty('--career-exit-distance', `${64 * matrix.a}px`);
			if (!html.hasAttribute('data-career-finished') && stops.top <= horizon.y + 8 && stops.bottom >= 0) {
				html.setAttribute('data-career-started', '');
				html.removeAttribute('data-career-waiting');
			}
		};
		function schedule() {
			if (!frame) frame = requestAnimationFrame(align);
		}
		const resize = new ResizeObserver(schedule);
		resize.observe(profile);
		resize.observe(land);
		resize.observe(hero);
		let previousSection = html.dataset.section;
		function onSectionChange() {
			if (previousSection === 'contact' && html.dataset.section !== 'contact') clearShortcut();
			previousSection = html.dataset.section;
			if (html.dataset.section !== 'accueil') {
				html.setAttribute('data-career-left-home', '');
			}
			schedule();
		}
		new MutationObserver(onSectionChange).observe(html, { attributes: true, attributeFilter: ['data-section'] });
		onSectionChange();
		window.addEventListener('scroll', schedule, { passive: true });
		align();
	}
</script>

<style>
	.career {
		color: var(--text-primary);
		padding-top: var(--spacing-5);
	}
	h3 {
		width: fit-content;
		margin: 0;
		padding: var(--spacing-1) var(--spacing-3);
		background: var(--surface-subtle);
		border-radius: var(--radius-md);
		font: 600 var(--text-body-m-size) / var(--text-body-m-line) var(--font-sans);
	}
	.road {
		position: relative;
		height: 2px;
		margin: var(--road-gap, var(--spacing-8)) 12.5% 0;
		background: var(--border-strong);
	}
	.trail { height: 100%; background: var(--action-primary); transform-origin: left; }
	:global(html:is([data-section='profil'], [data-section='contact']:is([data-career-started], [data-career-finished])) .hero .rider) {
		/* L’entrée du hero poursuit sa propre animation pendant le parcours. */
		transform: none !important;
		translate: var(--career-start, 360px) 0;
	}
	:global(html:is([data-section='profil'], [data-section='contact']):is([data-career-started], [data-career-finished]) .hero .rider) {
		translate: var(--career-end, 360px) 0;
	}
	:global(html[data-section='contact'][data-career-finished] .hero .rider) {
		translate: var(--contact-arrival, 360px) 0;
	}
	:global(html[data-contact-shortcut]:not([data-section='contact']) .hero .scene .rider) {
		opacity: 0;
	}
	:global(html[data-contact-shortcut][data-section='profil'] .hero .scene .rider) {
		transition: none;
	}
	:global(html[data-contact-shortcut][data-section='contact'] .hero .land .rider) {
		transform: none !important;
		translate: var(--contact-arrival, 360px) 0;
	}
	:global(html[data-contact-shortcut][data-section] .hero .scene .land g:has(> .rider)) {
		animation: none;
		opacity: 1;
	}

	.road i {
		position: absolute; top: 50%; translate: -50% -50%;
		width: .6rem; height: .6rem; border-radius: 50%;
		background: var(--action-primary); border: 2px solid var(--surface-subtle);
	}
	ol { background: var(--scene-ground); list-style: none; margin: 0; padding: var(--spacing-5) var(--spacing-8) var(--spacing-8); display: grid; gap: var(--spacing-5); }
	p { margin: 0; color: var(--text-secondary); font: 400 var(--text-body-s-size) / var(--text-body-s-line) var(--font-sans); }
	.date { font-weight: 600; color: var(--action-primary); }
	.name { margin: var(--spacing-1) 0; font-weight: 600; font-size: var(--text-body-m-size); color: var(--text-primary); }
	@media (min-width: 40rem) {
		:global(html[data-reduced-motion]) .career {
			margin-top: var(--spacing-5);
			padding: var(--spacing-5);
			border: 1px solid var(--border-default);
			border-radius: var(--radius-lg);
			background: var(--surface-elevated);
		}

		:global(html[data-reduced-motion]) h3 {
			padding: 0;
			background: none;
		}

		:global(html[data-reduced-motion]) .road {
			margin-top: var(--spacing-5);
		}

		:global(html[data-reduced-motion]) .road i {
			border-color: var(--surface-elevated);
		}

		:global(html[data-reduced-motion]) ol {
			padding-bottom: 0;
			background: none;
		}
	}

	@media (min-width: 40rem) and (max-width: 63.99rem) {
		:global(html[data-reduced-motion]) .road { display: none; }
		:global(html[data-reduced-motion]) ol { padding-inline: 0; }
	}

	@media (max-width: 39.99rem) {
		.career {
			margin-top: var(--spacing-5);
			padding: var(--spacing-5);
			border: 1px solid var(--border-default);
			border-radius: var(--radius-lg);
			background: var(--surface-elevated);
		}

		h3 {
			margin-bottom: var(--spacing-3);
			padding: 0;
			background: none;
		}

		.road { display: none; }

		ol {
			--step-gap: var(--spacing-4);
			padding: 0;
			gap: var(--step-gap);
			background: none;
		}

		li {
			position: relative;
			padding-inline-start: var(--spacing-5);
		}

		li::before,
		li:not(:last-child)::after {
			content: '';
			position: absolute;
		}

		li::before {
			inset-block-start: 0.4rem;
			inset-inline-start: 0;
			width: 0.4rem;
			height: 0.4rem;
			border-radius: 50%;
			background: var(--action-primary);
		}

		li:not(:last-child)::after {
			inset-block: 0.95rem calc(-1 * var(--step-gap) - 0.25rem);
			inset-inline-start: calc(0.2rem - 0.5px);
			width: 1px;
			background: var(--border-strong);
		}

		.date { color: var(--text-secondary); }
	}

	@media (min-width: 64rem) {
		ol { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 0; padding-inline: 0; }
		li { padding-inline: var(--spacing-4); text-align: center; }
	}
	@media (min-width: 40rem) and (prefers-reduced-motion: no-preference) {
		:global(html[data-career-waiting]:not([data-reduced-motion])) li { opacity: 0; }
		:global(html[data-career-waiting]:not([data-reduced-motion])) .trail { transform: scaleX(0); }
		:global(html[data-section='profil'][data-career-started]) li { animation: reveal 300ms ease-out var(--delay) backwards; }
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(html[data-section='profil'][data-career-started]) .trail { animation: draw 3.6s linear forwards, draw-exit 600ms ease-out 3.6s forwards; }
		:global(html[data-career-started] .hero .land g:has(> .rider)) { animation: career-ride 3.6s linear, career-exit 600ms ease-out 3.6s forwards; }
		:global(html[data-section='contact'][data-career-started] .hero .land g:has(> .rider)) { animation-play-state: paused; }
		:global(html[data-section='contact'][data-career-finished] .hero .land g:has(> .rider)) {
			animation: contact-fade 750ms linear both;
		}
		:global(html[data-section='profil'][data-career-finished] .hero .land g:has(> .rider)) {
			opacity: 0;
		}
		:global(html[data-section='profil'][data-career-started] .hero .rider .spokes) { animation: spin .45s linear 9; }
		:global(html:is([data-section='accueil'][data-career-left-home], [data-section='projets'], [data-section='contact'], [data-section='profil']:not([data-career-started])) .hero .rider .spokes) {
			animation: none;
		}
	}
	@keyframes career-exit {
		from { translate: 0 0; opacity: 1; }
		to { translate: 64px 0; opacity: 0; }
	}
	@keyframes contact-fade {
		from {
			translate: calc(var(--contact-stop, var(--career-end)) - var(--contact-arrival)) 0;
			opacity: var(--contact-start-opacity, 0);
		}
		32% {
			translate: calc(var(--contact-stop, var(--career-end)) - var(--contact-arrival)) 0;
			opacity: 0;
			animation-timing-function: step-end;
		}
		33.333% { translate: 0 0; opacity: 0; }
		to { translate: 0 0; opacity: 1; }
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(html[data-section='contact'][data-career-finished] .hero .wave-arm),
		:global(html[data-section='contact'][data-career-finished] .hero .wave-forearm) {
			animation-delay: 1.35s, 1.8s, 3.6s;
		}
	}
	/* Même départ progressif et même passage au deuxième repère pour le vélo et le tracé. */
	@keyframes career-ride {
		from {
			translate: calc(var(--career-start) - var(--career-end)) 0;
			animation-timing-function: cubic-bezier(.3, 0, .65, .65);
		}
		33.333333% { translate: calc((var(--career-start) - var(--career-end)) * 2 / 3) 0; }
		to { translate: 0 0; }
	}
	/* Le tracé suit le point de contact de la roue arrière, un empattement derrière les repères. */
	@keyframes draw {
		from {
			clip-path: inset(0 calc(100% + var(--wheelbase)) 0 0);
			animation-timing-function: cubic-bezier(.3, 0, .65, .65);
		}
		33.333333% { clip-path: inset(0 calc(200% / 3 + var(--wheelbase)) 0 0); }
		to { clip-path: inset(0 var(--wheelbase) 0 0); }
	}
	@keyframes draw-exit {
		from { clip-path: inset(0 var(--wheelbase) 0 0); }
		to { clip-path: inset(0 calc(var(--wheelbase) - var(--career-exit-distance)) 0 0); }
	}
	@keyframes spin { to { transform: rotate(1turn); } }
	@keyframes reveal { from { opacity: 0; transform: translateY(.4rem); } }
</style>
