---
import Button from '#lib/components/Button.svelte';
import ProjectImage from '#lib/components/ProjectImage.svelte';
import ProjectTags from '#lib/components/ProjectTags.svelte';
import WindowFrame from '#lib/components/WindowFrame.svelte';
import { projectPath, withBase } from '#lib/paths.js';
import type { ProjectEntry } from '#lib/projects.js';
import BaseLayout from './BaseLayout.astro';

type Props = {
	project: ProjectEntry;
	next?: ProjectEntry;
};

const { project, next } = Astro.props;
const { id: slug, data } = project;
---

<BaseLayout title={`${data.title} • Case study`} description={data.description}>
	<WindowFrame
		title={data.title}
		parent={{ href: `${withBase('/')}#projets`, label: 'Projets' }}
		transitionName={`project-${slug}-card`}
	>
		<article>
			<header class="hero">
				<ProjectImage
					src={withBase(data.image)}
					alt={data.imageAlt}
					transitionName={`project-${slug}-media`}
				/>
				<h1
					class="ds-h1"
					style={`view-transition-name: project-${slug}-title; view-transition-class: project-text;`}
				>
					{data.title}
				</h1>
				<ProjectTags tags={data.tags} transitionName={`project-${slug}-tags`} />
				<p
					class="subtitle ds-body-l"
					style={`view-transition-name: project-${slug}-summary; view-transition-class: project-text;`}
				>
					{data.description}
				</p>
			</header>

			<!-- Contenu Markdown (src/content/projects/<slug>.md). -->
			<div class="case-body">
				<slot />
			</div>

			{
				next && (
					<nav class="next" aria-label="Projet suivant">
						<div class="next-text">
							<p class="next-label ds-label-m">Projet suivant</p>
							<p class="next-title ds-h3">{next.data.title}</p>
						</div>
						<Button href={projectPath(next.id)} variant="secondary">
							Voir le projet →
						</Button>
					</nav>
				)
			}
		</article>
	</WindowFrame>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
		padding-bottom: var(--spacing-8);
	}

	.subtitle {
		max-width: 60ch;
		margin: 0;
		color: var(--text-secondary);
	}

	h1 {
		margin: 0;
	}

	/*
	 * Contenu Markdown (src/content/projects/<slug>.md), rendu tel quel par Astro :
	 * les styles visent directement ses éléments, d’où :global().
	 */
	.case-body {
		max-width: 40rem;
		padding-bottom: var(--spacing-10);
		color: var(--text-primary);
		font: 400 var(--text-body-m-size) / var(--text-body-m-line) var(--font-sans);
	}

	/* Chaque `##` ouvre une section : même rythme que l’ancien CaseStudySection. */
	.case-body :global(h2) {
		margin: calc(2 * var(--spacing-10)) 0 var(--spacing-5);
		color: var(--text-heading);
		font: 600 var(--text-h2-size) / var(--text-h2-line) var(--font-heading);
	}

	.case-body :global(h2:first-child) {
		margin-top: var(--spacing-10);
	}

	/* Intertitres `###` (anciens <h4>) : même rendu, hiérarchie de titres corrigée. */
	.case-body :global(h3) {
		margin: var(--spacing-6) 0 var(--spacing-2);
		font: 700 var(--text-body-m-size) / var(--text-body-m-line) var(--font-sans);
	}

	.case-body :global(h2 + h3) {
		margin-top: 0;
	}

	.case-body :global(p) {
		margin: 0 0 var(--spacing-4);
	}

	.case-body :global(ul) {
		margin: 0 0 var(--spacing-4);
		padding-left: 1.25rem;
	}

	.case-body :global(li + li) {
		margin-top: var(--spacing-2);
	}

	/*
	 * Image légendée : `![Texte alternatif](./image.webp)` suivi, à la ligne,
	 * de `*Légende*`. Markdown les place dans le même paragraphe.
	 */
	.case-body :global(p:has(> img)) {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.case-body :global(p > img) {
		width: 100%;
		height: auto;
		aspect-ratio: 35 / 18;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--surface-subtle);
		border: 1px solid var(--border-default);
	}

	.case-body :global(p:has(> img) > em) {
		color: var(--text-secondary);
		font: 400 var(--text-body-s-size) / var(--text-body-s-line) var(--font-sans);
		font-style: normal;
	}

	.next {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-4);
		margin-top: var(--spacing-8);
		padding-top: var(--spacing-10);
		border-top: 1px solid var(--border-default);
	}

	.next-text {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.next-label,
	.next-title {
		margin: 0;
	}

	.next-label {
		color: var(--text-secondary);
	}
</style>
